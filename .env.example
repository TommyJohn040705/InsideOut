# AI Studio / Google GenAI
GEMINI_API_KEY=

# Server Configuration
PORT=3000
NODE_ENV=development

# Google Maps (browser key). Restrict it to your site's HTTP referrers and to the
# "Maps JavaScript API" and "Directions API". Leave empty to use the MapLibre dev fallback.
VITE_GOOGLE_MAPS_API_KEY=
# Optional: a Map ID from Google Cloud for custom map styling.
VITE_GOOGLE_MAPS_MAP_ID=
# Optional: force a provider (google | maplibre).
VITE_MAP_PROVIDER=
