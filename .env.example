# Copy to .env.local and fill in. Never commit real keys.
# Server-side Gemini key (recommended). Used by /api/analyze-floorplan and /api/ask-wayfinder.
GEMINI_API_KEY=
# Optional: override the model (default gemini-3.8-flash, as used by the FloorNav prototype).
GEMINI_MODEL=
# Optional: port for npm run dev / npm start (default 3000).
PORT=3000
